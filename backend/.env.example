PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/cricket_auction
JWT_SECRET=change_this_secret

# Production Frontend URL (CRITICAL: In production set to https://cricleaguemanager.in)
FRONTEND_URL=http://localhost:5173

# =========================================================================
# Transactional Email (Choose Option 1 or Option 2 - Both are 100% Free)
# =========================================================================

# OPTION 1: Brevo (Recommended Free Option - 300 emails/day FREE forever, no credit card)
# 1. Sign up at brevo.com (free)
# 2. Go to SMTP & API -> Generate SMTP Key
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_brevo_login_email@example.com
# SMTP_PASS=your_brevo_smtp_master_key
# SMTP_FROM="CricLeagueManager <support@cricleaguemanager.in>"

# OPTION 2: Gmail SMTP (Free personal account using Google App Password)
# Note: Requires 2-Step Verification ON. Generate 16-char App Password at myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_app_password
SMTP_FROM="CricLeagueManager <your_email@gmail.com>"
